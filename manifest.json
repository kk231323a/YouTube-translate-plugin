{
  "manifest_version": 3,
  "name": "YouTube 中文字幕助手",
  "version": "1.1.0",
  "minimum_chrome_version": "138",
  "description": "优先使用原字幕并翻译成中文；完全没有字幕时可用本地语音识别生成中文字幕。",
  "permissions": ["storage", "tabCapture", "offscreen", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://translate.googleapis.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-caption-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content-v2.js"],
      "css": ["content-v2.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup-v2.html",
    "default_title": "YouTube 中文字幕助手"
  },
  "background": {
    "service_worker": "background-v2.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
